# Copy to .env (never commit .env). Anthropic-compatible API.
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_BASE_URL=https://llm-gateway-azure.penpencil.guru/anthropic
# PenPencil gateway: claude-* names map to MiniMax-M3.1-Flash, which over-thinks and returns no text.
# MiniMax-M2.7-highspeed answers in ~20–45s.
ANTHROPIC_MODEL=MiniMax-M2.7-highspeed

